# Environment Variables Template
# Copy this file to .env and configure the secrets.

# Gemini API Integration
GEMINI_API_KEY=

# Custom SMTP Server Configuration for Login Security Alerts
# Leave empty to automatically fallback to Ethereal Testing Mail Service (zero-config, sandbox safe)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@extractpro.com
